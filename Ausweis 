    <!-- Interactive Dashboard -->
    <div class="container mx-auto px-4 mb-12">
        <div class="glass-effect p-8 rounded-lg">
            <h2 class="text-2xl font-bold text-white mb-6">
                <i class="fas fa-tachometer-alt mr-2"></i>
